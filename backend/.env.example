NODE_ENV=development
PORT=3000

# Comma-separated list of exact allowed browser origins (no wildcards).
# In production every origin must use https.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace_with_your_local_password
DB_DATABASE=z_squared_solutions
# Set true when the database supports TLS. Must be true in production.
DB_SSL=false

# Email provider - configure when implementing Phase 5
EMAIL_FROM=
EMAIL_API_KEY=